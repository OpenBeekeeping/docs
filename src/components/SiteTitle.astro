---
// The coded Open Beekeeping lockup from the design system, so it follows the theme.
---

<a class="ob-lockup" href="/">
	<svg class="ob-mark" viewBox="0 0 32 32" aria-hidden="true">
		<polyline class="ob-mark__frame" points="9.75,5.17 3.5,16 9.75,26.83"></polyline>
		<polyline class="ob-mark__frame" points="22.25,5.17 28.5,16 22.25,26.83"></polyline>
		<path
			class="ob-mark__cell"
			d="M12.75 10.37 L19.25 10.37 L20.55 12.62 L11.45 12.62Z M10.15 14.87 L21.85 14.87 L22.5 16 L21.85 17.13 L10.15 17.13 L9.5 16Z M11.45 19.38 L20.55 19.38 L19.25 21.63 L12.75 21.63Z"
		></path>
	</svg>
	<span>open<b>beekeeping</b></span>
	<span class="docs-tag">docs</span>
</a>

<style>
	.ob-lockup {
		font-size: 18px;
	}
	.ob-lockup:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: 4px;
	}
	.docs-tag {
		margin-left: 0.2em;
		color: var(--brand-ink);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.02em;
	}
</style>
