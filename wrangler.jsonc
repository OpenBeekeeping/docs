{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "openbeekeeping-docs",
	"compatibility_date": "2026-10-06",

	// A static site: Cloudflare serves the built files directly, with no Worker code.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},

	"routes": [{ "pattern": "docs.openbeekeeping.org", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false
}
